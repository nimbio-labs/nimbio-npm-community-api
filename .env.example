# Copy to .env and load it however you like (dotenv, direnv, your shell).
# The client reads these automatically when you construct it with no arguments.

# Your API key. A nimbio_test_* key simulates side effects; a nimbio_live_*
# key performs them. test-vs-live is the KEY, not a separate flag.
NIMBIO_API_KEY=nimbio_test_your_key_here

# Which deployment to talk to: prod (default), dev, or local.
# NIMBIO_ENV=prod

# Override the base URL entirely (wins over NIMBIO_ENV).
# NIMBIO_BASE_URL=http://localhost:8000
